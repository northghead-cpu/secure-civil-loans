    "tools": [
      {
        "name": "get_my_kyc_status",
        "title": "Get my KYC status",
        "description": "Return the signed-in user's KYC verification status, employer details and consent state on Riverbanc.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_loan_applications",
        "title": "List my loan applications",
        "description": "List the signed-in user's Riverbanc loan applications with status, requested amount, selected lender and decision.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum applications to return (default 10, max 50).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "status": {
              "description": "Optional status filter, e.g. PENDING, APPROVED, DECLINED.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_lender_products",
        "title": "List lender products",
        "description": "List active Riverbanc lender loan products with interest rates, amount ranges and terms, for comparison.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "amount": {
              "description": "Optional loan amount in ZMW to filter products that support it.",
              "type": "number"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "check_affordability",
        "title": "Check loan affordability",
        "description": "Check a loan against the Zambian one-third-of-net-salary affordability rule and return the estimated monthly repayment.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "net_salary": {
              "type": "number",
              "description": "Monthly net salary in ZMW."
            },
            "amount": {
              "type": "number",
              "description": "Requested loan amount in ZMW."
            },
            "term_months": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Repayment term in months."
            },
            "annual_interest_rate": {
              "description": "Annual interest rate as a percentage, e.g. 24 for 24%. Defaults to 24.",
              "type": "number"
            }
          },
          "required": [
            "net_salary",
            "amount",
            "term_months"
          ]
        },
        "outputSchema": null
      }
    ]
  }
